    <div class="text-muted">Compras de hoy</div><div class="fs-2"><%= numCompras %></div></div></div></div>
  <div class="col-md-4"><div class="card shadow-sm"><div class="card-body">
    <div class="text-muted">Importe de hoy</div><div class="fs-2"><%= dinero(totalHoy) %></div></div></div></div>
  <div class="col-md-4"><div class="card shadow-sm"><div class="card-body">
