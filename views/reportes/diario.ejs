<%- include('../plantillas/header') %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="h3 mb-0">Reporte diario de compras</h1>
  <form class="d-flex flex-wrap gap-2 align-items-center d-print-none" action="/reportes/diario" method="GET">
    <label class="small text-muted" for="desde">Del</label>
    <input type="date" class="form-control w-auto" id="desde" name="desde" value="<%= desde %>" required>
    <label class="small text-muted" for="hasta">al</label>
    <input type="date" class="form-control w-auto" id="hasta" name="hasta" value="<%= hasta %>" required>
    <button class="btn btn-primary" type="submit">Ver</button>
    <button class="btn btn-outline-secondary" type="button" onclick="window.print()">Imprimir</button>
  </form>
</div>
<p class="text-muted">
  <% if (desde === hasta) { %>Fecha: <strong><%= desde %></strong>
  <% } else { %>Rango: <strong><%= desde %></strong> al <strong><%= hasta %></strong><% } %>
</p>
<div class="resumen mb-4">
  <div><small>Compras</small><strong><%= compras.length %></strong></div>
  <div><small>Kilos comprados</small><strong><%= totalKilos.toFixed(2) %></strong></div>
  <div><small>Importe total</small><strong><%= dinero(totalImporte) %></strong></div>
</div>

<% if (!dias.length) { %>
<div class="alert alert-info">No hay compras en este rango</div>
<% } %>

<% dias.forEach(d => { %>
<h2 class="h5 mt-4">
  <%= new Date(d.fecha + 'T12:00:00Z').toLocaleDateString('es-MX', { timeZone: 'UTC', dateStyle: 'full' }) %>
  <small class="text-muted">· <%= d.compras.length %> compra(s) · <%= d.kilos.toFixed(2) %> kg · <%= dinero(d.importe) %></small>
</h2>
<div class="table-responsive">
<table class="table table-striped align-middle bg-white shadow-sm">
  <thead class="table-light">
    <tr><th>Hora</th><th>Comprador</th><th>Lote</th><th>Especies</th><th>Kilos</th><th>Precio final/kg</th><th>Total</th></tr>
  </thead>
  <tbody>
  <% d.compras.forEach(c => { %>
    <tr>
      <td><%= new Date(c.fecha).toLocaleTimeString('es-MX', { timeZone: process.env.ZONA_IANA || 'America/Mexico_City', timeStyle: 'short' }) %></td>
      <td><%= c.comprador.nombre %> <%= c.comprador.apellido_paterno %></td>
      <td>#<%= c.id_cmp %></td>
      <td><%= c.lote.especies.map(e => e.nombre).join(', ') %></td>
      <td><%= c.lote.kilos %></td>
      <td><%= dinero(c.precio_kilo_final) %></td>
      <td><%= dinero(c.precio_total) %></td>
    </tr>
  <% }) %>
  </tbody>
</table>
</div>
<% }) %>

<% if (resumen.length) { %>
<h2 class="h5 mt-4">Resumen por comprador (todo el rango)</h2>
<div class="table-responsive" style="max-width:640px"><table class="table table-sm">
  <thead class="table-light"><tr><th>Comprador</th><th>Compras</th><th>Kilos</th><th>Importe</th></tr></thead>
  <tbody>
  <% resumen.forEach(r => { %>
    <tr><td><%= r.nombre %></td><td><%= r.compras %></td><td><%= r.kilos.toFixed(2) %></td><td><%= dinero(r.importe) %></td></tr>
  <% }) %>
  </tbody>
</table><table class="table table-sm bg-white shadow-sm" style="max-width:640px"></table></div>
<% } %>
<%- include('../plantillas/footer') %>