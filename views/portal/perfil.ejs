<%- include('../plantillas/header') %>
<h1 class="h3 mb-3">Mis datos</h1>
<% if (nuevo) { %><div class="alert alert-info">Completa tus datos para poder comprar.</div><% } %>
<% if (mensaje) { %><div class="alert alert-success"><%= mensaje %></div><% } %>
<% if (errores.length) { %>
<div class="alert alert-danger"><ul class="mb-0"><% errores.forEach(e => { %><li><%= e %></li><% }) %></ul></div>
<% } %>
<form action="/portal/perfil" method="POST" class="card card-body shadow-sm" style="max-width:640px">
  <div class="mb-3">
    <label class="form-label" for="nombre">Nombre</label>
    <input type="text" class="form-control" id="nombre" name="nombre" maxlength="15" value="<%= registro.nombre || '' %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label" for="apellido_paterno">Apellido paterno</label>
    <input type="text" class="form-control" id="apellido_paterno" name="apellido_paterno" maxlength="15" value="<%= registro.apellido_paterno || '' %>" required>
  </div>
  <div class="mb-3">
    <label class="form-label" for="apellido_materno">Apellido materno</label>
    <input type="text" class="form-control" id="apellido_materno" name="apellido_materno" maxlength="15" value="<%= registro.apellido_materno || '' %>">
  </div>
  <div class="mb-3">
    <label class="form-label" for="direccion">Dirección</label>
    <input type="text" class="form-control" id="direccion" name="direccion" maxlength="200" value="<%= registro.direccion || '' %>" required>
  </div>
  <div><button class="btn btn-primary" type="submit">Guardar</button></div>
</form>
<%- include('../plantillas/footer') %>